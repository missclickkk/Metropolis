# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BOT_TOKEN: Telegram Bot API token obtained from @BotFather.
# Configure this via the Secrets panel in the AI Studio UI (never commit real tokens).
BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# MINI_APP_URL: Optional override for the Telegram Mini App URL (defaults to APP_URL).
MINI_APP_URL="MY_MINI_APP_URL"

# CREATOR_TELEGRAM_ID: Telegram user ID allowed to access Dev Mode Master Control.
CREATOR_TELEGRAM_ID="630771271"
